# انسخ الملف ده لـ .env (محليًا) — وفي Coolify حط القيم في Environment Variables
# ⚠️ لا ترفع القيم الحقيقية على GitHub أبدًا

PORT=3000
DATA_DIR=./server/data

# مفتاح توقيع التوكن — لازم 32 حرف على الأقل، ولّد واحد قوي:
# powershell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_32_PLUS_CHARS

# حساب المالك الأول (يتعمل مرة واحدة عند أول تشغيل فقط)
ADMIN_USERNAME=حسن
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
